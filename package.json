{
  "name": "maxide",
  "version": "1.0.0",
  "type": "module",
  "description": "MaxIDE — AI-Native Software Engineering Studio with Unlimited Local & Cloud AI Providers",
  "main": "dist/server/index.js",
  "bin": {
    "maxide": "./bin/maxide.js"
  },
  "scripts": {
    "build": "tsc && powershell -NoProfile -Command \"if (Test-Path 'dist/ui') { Remove-Item -Path 'dist/ui' -Recurse -Force }; Copy-Item -Path 'src/ui' -Destination 'dist/ui' -Recurse -Force\"",
    "package": "npm run build && powershell -ExecutionPolicy Bypass -Command \"& 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /target:winexe /out:dist\\MaxIDE.exe /r:System.Windows.Forms.dll desktop\\MaxIDE.cs; Copy-Item dist\\MaxIDE.exe MaxIDE.exe -Force\"",
    "desktop": "powershell -ExecutionPolicy Bypass -Command \"Start-Process .\\MaxIDE.exe\"",
    "start": "tsx src/server/index.ts",
    "test": "tsx src/tests/acceptance.test.ts",
    "test:e2e": "tsx src/tests/ide_e2e.test.ts",
    "test:all": "tsx src/tests/acceptance.test.ts && tsx src/tests/ide_e2e.test.ts",
    "test:audit": "tsx src/tests/real_world_audit.ts",
    "test:final": "tsx src/tests/final_real_verification.ts",
    "test:simulate": "tsx src/tests/ui_user_simulation.ts",
    "test:agentic": "tsx src/tests/final_agentic_execution.test.ts",
    "test:formats": "tsx src/tests/universal_formats.test.ts",
    "test:ui": "tsx src/tests/real_ui_acceptance.test.ts",
    "test:desktop": "tsx src/tests/desktop_persistence.test.ts",
    "test:persistence": "tsx src/tests/persistence_recovery.test.ts",
    "test:recovery": "tsx src/tests/crash_and_shutdown.test.ts",
    "test:preview": "tsx src/tests/preview_routing.test.ts"
  },
  "keywords": [
    "maxide",
    "ai-ide",
    "antigravity",
    "ollama",
    "local-ai",
    "agent",
    "software-engineering"
  ],
  "author": "Burra Naveen Suraj",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}